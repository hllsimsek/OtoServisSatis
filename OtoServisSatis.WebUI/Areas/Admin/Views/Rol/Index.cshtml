@model IEnumerable<OtoServisSatis.Entities.Rol>

@{
    ViewData["Title"] = "Roller";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Roller</h1>
        <p class="page-subtitle">Sistemdeki kullanıcı rollerini yönetin.</p>
    </div>
    <a asp-action="Create" class="btn-date-picker">
        <i class="bi bi-plus-lg"></i>
        <span>Yeni Rol Ekle</span>
    </a>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Rol Listesi</h2>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Ad)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Ad)</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-quick-action">
                                    <i class="bi bi-pencil"></i> Düzenle
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-quick-action">
                                    <i class="bi bi-eye"></i> Detay
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-quick-action text-danger">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>