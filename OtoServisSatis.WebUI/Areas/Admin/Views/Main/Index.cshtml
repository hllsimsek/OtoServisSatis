@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<!-- START: Dashboard Header Banner -->
<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Araç satış ve servis işlemlerinizi tek ekrandan yönetin.</p>
    </div>
    <button class="btn-date-picker" type="button" id="date-picker-trigger">
        <i class="bi bi-calendar4-event"></i>
        <span id="selected-date-range">@DateTime.Now.ToString("dd MMMM yyyy")</span>
        <i class="bi bi-chevron-down ms-1"></i>
    </button>
</div>
<!-- END: Dashboard Header Banner -->
<!-- START: Main Layout Grid -->
<div class="row g-4">

    <!-- TOP AREA: Quick Info Stat Cards Row -->
    <div class="col-12">
        <div class="row g-4">
            <!-- Stat Card 1: Green Alert Banner -->
            <div class="col-md-4">
                <div class="card alert-green-card">
                    <div class="position-relative z-index-2">
                        <span class="alert-green-badge">Güncelleme</span>
                        <div class="alert-green-date">@DateTime.Now.ToString("dd MMMM yyyy")</div>
                        <div class="alert-green-text">Bu hafta satışlar %40 arttı</div>
                    </div>
                    <a href="#" class="alert-green-link z-index-2" id="alert-link-statistics">
                        <span>İstatistikleri Gör</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <svg class="alert-green-bg-shape" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <g transform="translate(50,50)">
                            <rect x="-6" y="-45" width="12" height="90" rx="6" ry="6" fill="#B4F105" />
                            <rect x="-6" y="-45" width="12" height="90" rx="6" ry="6" fill="#B4F105" transform="rotate(60)" />
                            <rect x="-6" y="-45" width="12" height="90" rx="6" ry="6" fill="#B4F105" transform="rotate(120)" />
                        </g>
                    </svg>
                </div>
            </div>

            <!-- Stat Card 2: Toplam Satış -->
            <div class="col-md-4">
                <div class="card card-stat d-flex flex-column justify-content-between">
                    <div>
                        <div class="card-header">
                            <span class="stat-label">Toplam Satış Geliri</span>
                            <div class="dropdown">
                                <button class="card-more-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="More Options" id="btn-more-income">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-arrow-repeat"></i> Yenile</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-file-earmark-arrow-down"></i> Rapor İndir</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="stat-value">₺196.000</div>
                        <div class="trend-badge trend-up">
                            <i class="bi bi-arrow-up-right"></i>
                            <span>Geçen aya göre +%35</span>
                        </div>
                    </div>
                    <div class="sparkline-container sparkline-card-footer">
                        <div id="income-sparkline"></div>
                    </div>
                </div>
            </div>

            <!-- Stat Card 3: Servis Geliri -->
            <div class="col-md-4">
                <div class="card card-stat d-flex flex-column justify-content-between">
                    <div>
                        <div class="card-header">
                            <span class="stat-label">Servis Geliri</span>
                            <div class="dropdown">
                                <button class="card-more-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="More Options" id="btn-more-return">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-arrow-repeat"></i> Yenile</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-file-earmark-arrow-down"></i> Rapor İndir</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="stat-value">₺32.000</div>
                        <div class="trend-badge trend-down">
                            <i class="bi bi-arrow-down-left"></i>
                            <span>Geçen aya göre -%24</span>
                        </div>
                    </div>
                    <div class="sparkline-container sparkline-card-footer">
                        <div id="return-sparkline"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- END: TOP AREA -->
    <!-- LEFT AREA -->
    <div class="col-xl-9 col-lg-8">
        <div class="row g-4">
            <!-- Revenue Chart -->
            <div class="col-12">
                <div class="card mb-0">
                    <div class="card-header mb-2">
                        <h2 class="card-title">Gelir</h2>
                        <div class="d-flex gap-3 align-items-center">
                            <div class="chart-legend-item">
                                <span class="legend-dot bg-forest-medium"></span>
                                <span class="chart-legend-label">Satış</span>
                            </div>
                            <div class="chart-legend-item">
                                <span class="legend-dot bg-lime-accent"></span>
                                <span class="chart-legend-label">Servis</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mb-3">
                        <span class="stat-value-amount">₺196.000</span>
                        <span class="trend-badge trend-up fs-xs">Geçen aya göre +%35</span>
                    </div>
                    <div id="revenue-chart"></div>
                </div>
            </div>

            <!-- Son İşlemler -->
            <div class="col-md-7 d-flex flex-column">
                <div class="card h-100 flex-grow-1">
                    <div class="card-header">
                        <h2 class="card-title">Son İşlemler</h2>
                        <div class="dropdown">
                            <button class="card-more-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    aria-label="More Options" id="btn-more-transaction">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                <li><a class="dropdown-item" href="#"><i class="bi bi-funnel"></i> Duruma Göre Filtrele</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-file-earmark-arrow-down"></i> CSV İndir</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="transaction-list">
                        <div class="transaction-item">
                            <div class="transaction-icon bg-forest-light text-lime">
                                <i class="bi bi-car-front"></i>
                            </div>
                            <div class="transaction-info">
                                <div class="transaction-name">Toyota Corolla Satışı</div>
                                <div class="transaction-date">14 Şub 2026 • 12:40</div>
                            </div>
                            <div class="transaction-amount text-success">+₺850.000</div>
                        </div>

                        <div class="transaction-item">
                            <div class="transaction-icon bg-forest-light text-lime">
                                <i class="bi bi-tools"></i>
                            </div>
                            <div class="transaction-info">
                                <div class="transaction-name">Periyodik Bakım</div>
                                <div class="transaction-date">13 Şub 2026 • 08:15</div>
                            </div>
                            <div class="transaction-amount text-success">+₺1.250</div>
                        </div>

                        <div class="transaction-item">
                            <div class="transaction-icon bg-forest-light text-lime">
                                <i class="bi bi-car-front"></i>
                            </div>
                            <div class="transaction-info">
                                <div class="transaction-name">Honda Civic Satışı</div>
                                <div class="transaction-date">11 Şub 2026 • 16:30</div>
                            </div>
                            <div class="transaction-amount text-success">+₺920.000</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Araç Durumu Özeti -->
            <div class="col-md-5 d-flex flex-column">
                <div class="card h-100 flex-grow-1">
                    <div class="card-header">
                        <h2 class="card-title">Araç Durumu</h2>
                        <div class="dropdown">
                            <button class="card-more-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    aria-label="More Options" id="btn-more-products">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                <li><a class="dropdown-item" href="#"><i class="bi bi-plus-lg"></i> Araç Ekle</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="progress-container">
                        <div class="progress-label-row">
                            <span class="progress-label">Stokta</span>
                            <span class="progress-value">233</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-lime-accent w-65"></div>
                        </div>
                    </div>

                    <div class="progress-container">
                        <div class="progress-label-row">
                            <span class="progress-label">Serviste</span>
                            <span class="progress-value">23</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-lime-accent opacity-50 w-50"></div>
                        </div>
                    </div>

                    <div class="progress-container">
                        <div class="progress-label-row">
                            <span class="progress-label">Satıldı</span>
                            <span class="progress-value">482</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-lime-accent w-85"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT AREA -->
    <div class="col-xl-3 col-lg-4">
        <div class="right-panel-wrapper d-flex flex-column gap-4 h-100">

            <div class="card flex-grow-1 d-flex flex-column justify-content-between mb-0">
                <div class="card-header mb-1">
                    <h2 class="card-title">Görüntülenme Performansı</h2>
                </div>
                <div id="views-chart"></div>
                <div class="chart-legends-container">
                    <div class="chart-legend-item">
                        <span class="legend-dot bg-lime-accent"></span>
                        <span class="text-muted-green">Görüntülenme</span>
                    </div>
                    <div class="chart-legend-item">
                        <span class="legend-dot bg-forest-medium"></span>
                        <span class="text-muted-green">Yüzde</span>
                    </div>
                    <div class="chart-legend-item">
                        <span class="legend-dot bg-brand-orange"></span>
                        <span class="text-muted-green">Satış</span>
                    </div>
                </div>
            </div>

            <div class="promo-banner-card">
                <svg class="promo-banner-bg-shape" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g transform="translate(50,50)">
                        <rect x="-6" y="-45" width="12" height="90" rx="6" ry="6" fill="#B4F105" />
                        <rect x="-6" y="-45" width="12" height="90" rx="6" ry="6" fill="#B4F105" transform="rotate(60)" />
                        <rect x="-6" y="-45" width="12" height="90" rx="6" ry="6" fill="#B4F105" transform="rotate(120)" />
                    </g>
                </svg>
                <h3 class="promo-title">Satışlarınızı bir üst seviyeye taşıyın.</h3>
                <p class="promo-desc">Tüm araç ve servis işlemlerinizi özenle yönetin.</p>
                <button class="btn-promo" id="btn-promo-action">Güncellemeleri İncele</button>
            </div>
        </div>
    </div>

</div>
<!-- END: Main Layout Grid -->
@section Scripts {
    <script src="~/spark-admin-1.0.0/assets/js/dashboard.js"></script>
}
