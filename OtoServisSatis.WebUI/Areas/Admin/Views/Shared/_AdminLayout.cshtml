<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - OtoServisSatis Admin</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/spark-admin-1.0.0/assets/images/favicon.ico">

    <!-- Local Third-Party Libraries -->
    <link rel="stylesheet" href="~/spark-admin-1.0.0/assets/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/spark-admin-1.0.0/assets/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/spark-admin-1.0.0/assets/libs/apexcharts/apexcharts.css">
    <link rel="stylesheet" href="~/spark-admin-1.0.0/assets/libs/flatpickr/flatpickr.min.css">

    <!-- Main Design System & Custom Stylesheet -->
    <link rel="stylesheet" href="~/spark-admin-1.0.0/assets/css/main.css">
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ==========================================
         START: Sidebar Component
         ========================================== -->
    <div class="sidebar-wrapper" id="sidebar">
        <!-- Brand Logo / Identity -->
        <a asp-area="Admin" asp-controller="Main" asp-action="Index" class="sidebar-brand">
            <i class="bi bi-asterisk"></i>
            <span>OtoServisSatis</span>
        </a>

        <!-- Navigation Menu -->
        <div class="flex-grow-1 overflow-y-auto">
            <!-- Group: Menu -->
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Menu</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item">
                        <a asp-area="Admin" asp-controller="Main" asp-action="Index" class="sidebar-menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Main" ? "active" : "")"
                           id="menu-overview" title="Overview">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Group: Yönetim -->
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Yönetim</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item">
                        <a href="#" class="sidebar-menu-link" id="menu-araclar" title="Araçlar">
                            <i class="bi bi-car-front"></i>
                            <span>Araçlar</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-area="Admin" asp-controller="Kullanici" asp-action="Index"
                           class="sidebar-menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kullanici" ? "active" : "")"
                           id="menu-musteriler" title="Kullanicilar">
                            <i class="bi bi-people"></i>
                            <span>Kullanıcılar</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-area="Admin" asp-controller="Rol" asp-action="Index"
                           class="sidebar-menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rol" ? "active" : "")"
                           id="menu-musteriler" title="Rolller">
                            <i class="bi bi-people"></i>
                            <span>Roller</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="#" class="sidebar-menu-link" id="menu-servisler" title="Servis Kayıtları">
                            <i class="bi bi-tools"></i>
                            <span>Servis Kayıtları</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Sidebar Profile Card -->
        <div class="sidebar-profile">
            <img src="~/spark-admin-1.0.0/assets/images/avatar.png" alt="Administrator" class="sidebar-profile-img"
                 onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=256&auto=format&fit=crop'">
            <div class="sidebar-profile-info">
                <div class="sidebar-profile-name">Administrator</div>
                <div class="sidebar-profile-email">admin@otoservissatis.com</div>
            </div>
        </div>
    </div>
    <!-- ==========================================
         END: Sidebar Component
         ========================================== -->
    <!-- ==========================================
         START: Main Content Area
         ========================================== -->
    <div class="main-wrapper">

        <!-- START: Top Navbar Component -->
        <header class="navbar-custom">
            <div class="navbar-left">
                <!-- Desktop sidebar toggle -->
                <button class="btn-desktop-toggle d-none d-xl-flex align-items-center justify-content-center me-3"
                        id="desktop-sidebar-toggle" aria-label="Minimize Sidebar">
                    <i class="bi bi-chevron-bar-left"></i>
                </button>
                <!-- Mobile sidebar toggle -->
                <button class="sidebar-toggle-btn me-2" id="sidebar-toggle" aria-label="Toggle Navigation">
                    <i class="bi bi-list"></i>
                </button>

                <!-- Quick Actions Dropdown -->
                <div class="dropdown ms-2">
                    <button class="btn-quick-action dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            aria-expanded="false" id="quick-actions-dropdown">
                        <i class="bi bi-plus-lg"></i>
                        <span>Create</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-quick-action" aria-labelledby="quick-actions-dropdown">
                        <li class="dropdown-header">Hızlı İşlemler</li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-car-front"></i> Yeni Araç</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person-plus"></i> Yeni Müşteri</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-tools"></i> Yeni Servis Kaydı</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear"></i> Sistem Ayarları</a></li>
                    </ul>
                </div>
            </div>

            <!-- Mid navbar: search pill -->
            <div class="navbar-search-wrapper">
                <input type="text" class="navbar-search-input" placeholder="Ara..." id="main-search">
                <button class="navbar-search-btn" aria-label="Search">
                    <i class="bi bi-search"></i>
                </button>
            </div>

            <!-- Right actions -->
            <div class="navbar-actions">
                <!-- Fullscreen Toggle -->
                <button class="navbar-action-btn me-1" aria-label="Toggle Fullscreen" id="btn-fullscreen">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>

                <!-- Notifications -->
                <div class="dropdown">
                    <button class="navbar-action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            aria-expanded="false" id="btn-notifications" data-bs-auto-close="outside">
                        <i class="bi bi-bell"></i>
                        <span class="navbar-action-badge"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-notification p-0"
                         aria-labelledby="btn-notifications">
                        <div class="notification-header">
                            <h6 class="notification-title">Bildirimler</h6>
                            <button class="btn-clear-all" type="button">Tümünü okundu işaretle</button>
                        </div>
                        <div class="notification-list">
                            <a href="#" class="notification-item">
                                <div class="notification-icon bg-success text-white">
                                    <i class="bi bi-wallet2"></i>
                                </div>
                                <div class="notification-content">
                                    <p class="notification-text">Yeni satış: <strong>Toyota Corolla</strong></p>
                                    <span class="notification-time">2 dakika önce</span>
                                </div>
                                <span class="notification-unread-dot"></span>
                            </a>
                            <a href="#" class="notification-item">
                                <div class="notification-icon bg-primary text-white">
                                    <i class="bi bi-person-plus-fill"></i>
                                </div>
                                <div class="notification-content">
                                    <p class="notification-text">Yeni müşteri kaydedildi</p>
                                    <span class="notification-time">1 saat önce</span>
                                </div>
                                <span class="notification-unread-dot"></span>
                            </a>
                        </div>
                        <a href="#" class="notification-footer">Tüm Bildirimleri Gör</a>
                    </div>
                </div>

                <!-- Profile Dropdown -->
                <div class="dropdown ms-2">
                    <button class="navbar-profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            aria-expanded="false" id="profile-dropdown">
                        <img src="~/spark-admin-1.0.0/assets/images/avatar.png" alt="Profile Image"
                             class="navbar-profile-img">
                        <span class="navbar-profile-name d-none d-md-inline">Administrator</span>
                        <i class="bi bi-chevron-down navbar-profile-caret"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-profile" aria-labelledby="profile-dropdown">
                        <li class="dropdown-header">Hoş geldin!</li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person"></i> Hesabım</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear"></i> Ayarlar</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <a class="dropdown-item text-danger" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-box-arrow-right"></i> Çıkış Yap
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        <!-- END: Top Navbar Component -->
        <!-- Sayfaya özel içerik burada render edilecek (Index.cshtml, Araclar.cshtml vs.) -->
        @RenderBody()

        <!-- START: Footer Component -->
        <footer class="footer-custom">
            <div class="footer-left">
                <span class="footer-logo">
                    <i class="bi bi-asterisk"></i> OtoServisSatis
                </span>
                <span class="footer-separator">|</span>
                <span class="footer-copy">&copy; @DateTime.Now.Year - OtoServisSatis Admin Panel</span>
            </div>
        </footer>
        <!-- END: Footer Component -->

    </div>
    <!-- ==========================================
         END: Main Content Area
         ========================================== -->
    <!-- Local Third-Party Libraries Script dependencies -->
    <script src="~/spark-admin-1.0.0/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/spark-admin-1.0.0/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="~/spark-admin-1.0.0/assets/libs/flatpickr/flatpickr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
